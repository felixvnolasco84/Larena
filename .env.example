# Next.js: npx convex dev creates .env.local with these deployment values.
CONVEX_DEPLOYMENT=
NEXT_PUBLIC_CONVEX_URL=
NEXT_PUBLIC_CONVEX_SITE_URL=
# Generate a random secret and set the same value on Next.js and Convex.
KYC_FILE_PROXY_SECRET=

# Existing contact email integration (Next.js server only).
RESEND_API_KEY=

# Set these separately on the Convex DEVELOPMENT and PRODUCTION deployments.
# Never prefix server secrets with NEXT_PUBLIC_.
SITE_URL=https://larena.mx
KYC_STAFF_EMAILS=
KYC_NOTIFICATION_EMAILS=
KYC_PRIVACY_URL=https://www.larena.mx/kyc/aviso-privacidad
KYC_EMAIL_FROM=
# Native KYC notice: set the same public controller profile on Next.js and Convex.
KYC_CONTROLLER_NAME=
KYC_CONTROLLER_ADDRESS=
KYC_PRIVACY_EMAIL=
# Convex also needs RESEND_API_KEY, JWT_PRIVATE_KEY and JWKS.
# See docs/KYC.md; signing keys can be configured with npm run convex:auth-keys.
